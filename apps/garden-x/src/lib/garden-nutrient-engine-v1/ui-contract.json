{
  "version": "garden-nutrient-engine-v1",
  "unit": "mS/cm",
  "modes": {
    "FRESH_RECIPE": {
      "requiredInputs": ["recipeId"],
      "optionalInputs": [
        "volumeL",
        "podCount",
        "feedingIndex",
        "contexts",
        "dosingEquipmentResolutionMl"
      ],
      "conditionalInputs": [
        "volumeL for mL/L recipes",
        "podCount for pod-group recipes",
        "feedingIndex when more than one manufacturer step matches"
      ],
      "derivedValues": ["component doses", "manufacturerRecipeExpectation", "cropCompatibility"],
      "outputs": ["manufacturer recipe", "component doses", "mixing order"],
      "warnings": [
        "CROP_COMPATIBILITY_UNCERTAIN",
        "CROP_COMPATIBILITY_CONFLICTING",
        "MANUFACTURER_CROP_EC_DISAGREEMENT",
        "DOSE_BELOW_EQUIPMENT_RESOLUTION"
      ],
      "errors": [
        "RECIPE_UNAVAILABLE",
        "UNSUPPORTED_POD_COUNT",
        "RECIPE_STAGE_REQUIRED",
        "VOLUME_REQUIRED",
        "INVALID_VOLUME"
      ],
      "evidenceStates": ["HIGH", "MODERATE", "LOW", "CONFLICTING", "INSUFFICIENT"],
      "explainability": [
        "manufacturer dose",
        "manufacturer expected EC",
        "source",
        "compatibility uncertainty"
      ]
    },
    "FRESH_TARGET_EC": {
      "requiredInputs": ["contexts"],
      "optionalInputs": [
        "userSelectedTarget",
        "meterResolution",
        "observations",
        "sourceWaterEc",
        "reservoirVolumeL",
        "calibration",
        "dosingEquipmentResolutionMl"
      ],
      "conditionalInputs": [
        "userSelectedTarget may proceed when crop evidence is insufficient",
        "sourceWaterEc, reservoirVolumeL and exact-product calibration are required for an actionable fresh dose"
      ],
      "derivedValues": [
        "common applicable range",
        "suggestedStartingPoint",
        "volume-normalized calibrated dose"
      ],
      "outputs": [
        "target range",
        "optional suggested starting point",
        "optional actionable nutrient dose",
        "requires measurement"
      ],
      "warnings": [
        "STARTING_POINT_POLICY",
        "STARTING_POINT_SUPPRESSED",
        "USER_TARGET_OUTSIDE_EVIDENCE",
        "USER_TARGET_WITHOUT_COMMON_EVIDENCE",
        "CALIBRATION_EXTRAPOLATION",
        "DOSE_BELOW_EQUIPMENT_RESOLUTION"
      ],
      "errors": [
        "INSUFFICIENT_EC_EVIDENCE",
        "CALIBRATION_UNAVAILABLE",
        "SOURCE_WATER_SCOPE_REQUIRED",
        "SOURCE_WATER_ABOVE_TARGET",
        "INVALID_FRESH_TARGET_INPUT"
      ],
      "evidenceStates": ["HIGH", "MODERATE", "LOW", "CONFLICTING", "INSUFFICIENT"],
      "explainability": ["source range", "user target", "starting-point inference", "dependencies"]
    },
    "EC_CORRECTION": {
      "requiredInputs": ["currentEc", "targetEc", "reservoirVolumeL", "calibration"],
      "optionalInputs": [
        "reservoirCapacityL",
        "dilutionWaterEc",
        "policy.firstStepFraction",
        "policy.dosingEquipmentResolutionMl"
      ],
      "conditionalInputs": [
        "currentEc scope must be NUTRIENT_SOLUTION",
        "reservoirVolumeL is the measured actual remaining volume, not nominal capacity",
        "dilutionWaterEc is required when current EC exceeds target"
      ],
      "derivedValues": ["doseMl or waterMl", "optional firstStepDoseMl"],
      "outputs": ["direction", "dose", "requiresRemeasurement"],
      "warnings": [
        "CALIBRATION_EXTRAPOLATION",
        "PARTIAL_DOSE_POLICY",
        "DOSE_BELOW_EQUIPMENT_RESOLUTION"
      ],
      "errors": [
        "INCOMPATIBLE_MEASUREMENT_SCOPE",
        "INVALID_CORRECTION_INPUT",
        "DILUTION_EXCEEDS_CAPACITY"
      ],
      "evidenceStates": ["HIGH", "MODERATE", "LOW", "CONFLICTING", "INSUFFICIENT"],
      "explainability": [
        "measured EC",
        "selected target",
        "calibration factor",
        "correction calculation"
      ]
    },
    "TOP_UP_MAINTENANCE": {
      "requiredInputs": [
        "currentVolumeL",
        "nominalVolumeL",
        "replacementWaterL",
        "currentEc",
        "targetEc"
      ],
      "optionalInputs": [
        "calibration",
        "replacementWaterEc",
        "policy.enableCumulativeTopUpHeuristic"
      ],
      "conditionalInputs": [
        "calibration when nutrient addition is required",
        "currentVolumeL is never inferred from nominal capacity",
        "replacementWaterEc is required for a positive replacementWaterL"
      ],
      "derivedValues": [
        "resultingVolumeL",
        "afterWaterEc",
        "optional nutrientDoseMl",
        "optional dilutionWaterMl"
      ],
      "outputs": [
        "replacement water",
        "optional nutrient dose",
        "optional further dilution",
        "approximation marker"
      ],
      "warnings": [
        "LINEAR_MIXING_APPROXIMATION",
        "CALIBRATION_EXTRAPOLATION",
        "CUMULATIVE_TOP_UP_REPLACEMENT_GUIDANCE"
      ],
      "errors": [
        "CURRENT_VOLUME_REQUIRED",
        "RESERVOIR_CAPACITY_EXCEEDED",
        "DILUTION_EXCEEDS_CAPACITY",
        "CALIBRATION_REQUIRED"
      ],
      "evidenceStates": ["HIGH", "MODERATE", "LOW", "CONFLICTING", "INSUFFICIENT"],
      "explainability": [
        "measured EC",
        "replacement water",
        "diluted EC",
        "calibration-derived dose",
        "not nutrient balance"
      ]
    }
  },
  "calibrationCapture": {
    "requiredInputs": [
      "exact productIdentity",
      "formulationVersion",
      "recipeContextSignature",
      "componentRatioSignature",
      "componentDosesMl actually applied",
      "baselineEc",
      "resultingEc",
      "actual sample reservoirVolumeL"
    ],
    "rules": [
      "Never substitute recommended dose for actual applied dose",
      "Never substitute manufacturer expected EC for measured resulting EC",
      "Reuse only applicable exact-product/recipe-context observations",
      "Persist locally; no canonical Garden writes"
    ]
  },
  "epistemicClasses": [
    "SOURCE_BACKED_FACT",
    "MANUFACTURER_INSTRUCTION",
    "USER_CALIBRATION",
    "DETERMINISTIC_CALCULATION",
    "ENGINE_INFERENCE",
    "UNVALIDATED_ASSUMPTION",
    "USER_SELECTED"
  ],
  "measurementScopes": [
    "NUTRIENT_SOLUTION",
    "ROOT_ZONE",
    "SOURCE_WATER",
    "RUNOFF_OR_LEACHATE",
    "UNKNOWN"
  ],
  "scopeBases": ["STATED", "INFERRED", "UNKNOWN"],
  "principles": [
    "EC is not nutrient balance",
    "PPM is outside V1; mS/cm and uS/cm conversion is deterministic",
    "UNKNOWN scope never becomes NUTRIENT_SOLUTION",
    "manufacturer expected EC is not crop requirement",
    "plant count is contextual and never weights the target in V1",
    "historical or low-tier evidence does not automatically create a target"
  ]
}
